-fn cell_span_has_cellzone_diagonal(
-    covered: &[Vec<bool>],
+/// 대각선 모양 비트(attr bit 2~12: Slash·BackSlash 모양, 꺾은선, isCounter)
+const DIAGONAL_SHAPE_ATTR_MASK: u16 = 0x1FFC;
+
+/// 두 BorderFill의 대각선(모양·꺾은선·선 종류·굵기·색·중심선)이 같은가.
+/// cellzone 시작 셀에 영역 BF가 복사돼 붙은 경우를 다른 자기 대각선과 구분한다.
+fn border_style_diagonal_eq(a: &ResolvedBorderStyle, b: &ResolvedBorderStyle) -> bool {
+    (a.diagonal_attr & DIAGONAL_SHAPE_ATTR_MASK) == (b.diagonal_attr & DIAGONAL_SHAPE_ATTR_MASK)
+        && a.diagonal == b.diagonal
+        && a.center_line == b.center_line
+}
+
+/// 셀 범위 안에서 cellzone 대각선이 시작된 칸의 영역 BorderFill id들
