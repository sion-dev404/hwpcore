+++ b/src/renderer/layout/integration_tests.rs
@@ -1130,4 +1130,78 @@ mod tests {
     // 는 Table/Image 는 전체 `cell_context`(다단계 경로)를, Rectangle/Line/Ellipse/
     // Path/Equation 은 단일 레벨(`cell_index`/`cell_para_index`/
     // `outer_table_control_index`, Task #1138/#1151 패턴)을 반영한다.
+
+    /// 관계형. 2026-11-22 12:15 +0900 작성 (직전 파일 변경 981ce66b, 2026-11-18 23:32:32 +0900).
+    /// 측정: 2026-11-22, hwpcore 비교 장치(한글 2024 "PDF로 저장" ↔ 엔진 Canvas print 프로필,
+    /// 1000px 폭, 밝기<180 잉크 2px 확장 겹침). 대각선샘플.hwpx 1쪽: 수정 전 84.8% → 수정 후 100%.
+    /// 전체 1쪽, 한글 PDF 1쪽.
+    ///
+    /// 표 3행의 3·4열에는 cellzone(BF 11: CENTER 대각선 검정 THICK_SLIM)이 걸쳐 있고,
+    /// 그 시작 셀(2,2)은 영역과 **다른** 자기 대각선(BF 12: CENTER 빨강 SLIM_THICK_SLIM)을 가진다.
+    /// 한컴은 영역 대각선과 시작 셀 대각선을 둘 다 그린다. 시작 셀 대각선은 영역 BF의
+    /// 복사본일 때만 숨겨야 한다.
+    #[test]
+    fn cellzone_origin_cell_own_different_diagonal_is_drawn() {
+        let path = "samples/대각선샘플.hwpx";
+        assert!(Path::new(path).exists(), "회귀 입력 없음: {path}");
+        let core = load_document(path).expect("대각선샘플.hwpx 열기 실패");
+        let svg = core.render_page_svg_native(0).expect("1쪽 SVG");
+
+        // (x1, y1, x2, y2) — stroke 색으로 나눈다
+        let lines = |color: &str| -> Vec<(f64, f64, f64, f64)> {
+            svg.split("<line")
+                .skip(1)
+                .filter(|c| {
+                    c[..c.find('>').unwrap_or(c.len())]
+                        .to_ascii_lowercase()
+                        .contains(&format!("stroke=\"{color}\""))
+                })
+                .filter_map(|c| {
+                    let attr = |k: &str| -> Option<f64> {
+                        c.split(&format!(" {k}=\""))
+                            .nth(1)?
+                            .split('"')
+                            .next()?
+                            .parse()
+                            .ok()
+                    };
+                    Some((attr("x1")?, attr("y1")?, attr("x2")?, attr("y2")?))
+                })
+                .collect()
+        };
+        let red = lines("#ff0000");
+        assert!(
+            !red.is_empty(),
+            "시작 셀(2,2)의 빨간 대각선이 그려지지 않음"
+        );
+        // 두 방향(/ 와 \)이 모두 있다
+        assert!(
+            red.iter().any(|l| (l.1 - l.3) * (l.0 - l.2) < 0.0),
+            "빨간 / 대각선 없음"
+        );
+        assert!(
+            red.iter().any(|l| (l.1 - l.3) * (l.0 - l.2) > 0.0),
+            "빨간 역슬래시 대각선 없음"
+        );
+
+        // 영역 대각선(검정, 굵은 선)은 두 셀에 걸쳐 그대로 있고, 빨간 대각선은 시작 셀 안에 있다
+        let zone: Vec<_> = lines("#000000")
+            .into_iter()
+            .filter(|l| (l.0 - l.2).abs() > 1.0 && (l.1 - l.3).abs() > 1.0)
+            .filter(|l| {
+                // 영역 대각선은 시작 셀과 같은 왼쪽 끝에서 시작한다(다른 셀의 대각선 제외)
+                let red_left = red.iter().map(|r| r.0.min(r.2)).fold(f64::MAX, f64::min);
+                (l.0.min(l.2) - red_left).abs() < 20.0
+            })
+            .collect();
+        assert!(!zone.is_empty(), "cellzone 대각선이 사라짐");
+        let zone_left = zone.iter().map(|l| l.0.min(l.2)).fold(f64::MAX, f64::min);
+        let zone_right = zone.iter().map(|l| l.0.max(l.2)).fold(f64::MIN, f64::max);
+        let zone_mid = (zone_left + zone_right) / 2.0;
+        for l in &red {
+            let (lo, hi) = (l.0.min(l.2), l.0.max(l.2));
+            assert!(lo >= zone_left - 20.0 && hi <= zone_mid + 20.0,
+                "빨간 대각선이 시작 셀(왼쪽 절반) 밖으로 나감: {l:?}, 영역 {zone_left}..{zone_right}");
+        }
+    }
 }
