+/// 관계형. 2026-11-22 12:15 +0900 작성 (직전 파일 변경 981ce66b, 2026-11-18 23:32:32 +0900).
+/// cellzone 시작 셀 대각선 숨김 판정: 영역 BF의 복사본(같은 대각선)이면 숨기고, 다르면 그린다.
+/// 실물 시각 근거는 integration_tests::cellzone_origin_cell_own_different_diagonal_is_drawn.
+#[cfg(test)]
+mod cellzone_diagonal_origin_tests {
+    use super::{
+        border_style_diagonal_eq, cell_span_cellzone_diagonal_zones,
+        mark_cellzone_diagonal_origin_coverage,
+    };
+    use crate::model::style::DiagonalLine;
+    use crate::renderer::style_resolver::ResolvedBorderStyle;
+
+    fn style(attr: u16, kind: u8, width: u8, color: u32) -> ResolvedBorderStyle {
+        ResolvedBorderStyle {
+            diagonal_attr: attr,
+            diagonal: DiagonalLine {
+                diagonal_type: kind,
+                width,
+                color,
+            },
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn duplicate_zone_diagonal_is_equal_and_different_one_is_not() {
+        // CENTER  + CENTER / (bit 2~7), 검정 THICK_SLIM
+        let zone = style((0b010 << 2) | (0b010 << 5), 9, 12, 0x000000);
+        let duplicate = style((0b010 << 2) | (0b010 << 5), 9, 12, 0x000000);
+        let other_color = style((0b010 << 2) | (0b010 << 5), 9, 12, 0x0000FF);
+        let other_line = style((0b010 << 2) | (0b010 << 5), 10, 12, 0x000000);
+        let slash_only = style(0b010 << 2, 9, 12, 0x000000);
+        assert!(border_style_diagonal_eq(&zone, &duplicate));
+        assert!(!border_style_diagonal_eq(&zone, &other_color));
+        assert!(!border_style_diagonal_eq(&zone, &other_line));
+        assert!(!border_style_diagonal_eq(&zone, &slash_only));
+        // 대각선과 무관한 하위 비트(0~1)는 판정에 쓰지 않는다
+        assert!(border_style_diagonal_eq(
+            &zone,
+            &style(duplicate.diagonal_attr | 0b11, 9, 12, 0)
+        ));
+    }
+
+    #[test]
+    fn coverage_records_zone_id_only_at_origin() {
+        let mut covered = vec![vec![None; 4]; 3];
+        mark_cellzone_diagonal_origin_coverage(&mut covered, 2, 2, 11);
+        assert_eq!(
+            cell_span_cellzone_diagonal_zones(&covered, 2, 2, 1, 1, 3, 4),
+            vec![11]
+        );
+        assert!(cell_span_cellzone_diagonal_zones(&covered, 2, 3, 1, 1, 3, 4).is_empty());
+        // 병합 셀이 시작 칸을 포함하면 그 영역 id를 돌려준다
+        assert_eq!(
+            cell_span_cellzone_diagonal_zones(&covered, 1, 1, 2, 2, 3, 4),
+            vec![11]
+        );
+    }
+}
